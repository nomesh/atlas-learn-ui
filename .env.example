# ATLAS Learn environment template. Copy to .env.local (git-ignored) and adjust.
#
# TUTOR MODE: three situations, never confuse them
#   production build   -> always LIVE (mock is impossible, regardless of anything below)
#   development LIVE   -> real backend + real model          (npm run dev:live)
#   development MOCK   -> offline fixtures, backend bypassed (npm run dev:mock)
#
# VITE_USE_MOCK_API must be exactly 'true' or 'false'.
#   false -> LIVE.   true -> MOCK.   unset or invalid -> LIVE (a typo never silently gives you fixtures).
# .env.local overrides .env. A real environment variable (what dev:live / dev:mock set) overrides both.
# The browser toggle stores localStorage 'atlas_force_mock', which overrides all of the above until cleared
# (use "clear override" on the dev badge).
VITE_USE_MOCK_API=false

# Leave blank to use Vite's dev proxy (/api -> http://localhost:8080)
VITE_API_BASE_URL=
VITE_APP_TITLE=ATLAS Learn
# Optional: tenant identity for local development (no silent defaults used)
VITE_ATLAS_TENANT_ID=
# Optional: dev-only bearer JWT for a secured live backend. Never commit a real token.
VITE_ATLAS_AUTH_TOKEN=
