{
  "name": "atlas-learn-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "test:node": "node --import tsx --test tests/curriculum-integrity.test.mjs tests/learn-ui-artifact-workflow.test.mjs src/test/tutorLeaseLifecycle.test.ts",
    "test:ui": "vitest run",
    "verify:production": "node --import tsx scripts/verify-production-build.mjs --target=production",
    "verify:pages-demo": "node --import tsx scripts/verify-production-build.mjs --target=pages-demo",
    "test": "npm run lint && npm run test:node && npm run test:ui && npm run verify:production && npm run verify:pages-demo",
    "dev:live": "node scripts/dev.mjs live",
    "dev:mock": "node scripts/dev.mjs mock"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.66.0",
    "@types/katex": "^0.16.8",
    "axios": "^1.11.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.4.7",
    "i18next": "^24.2.2",
    "katex": "^0.18.9",
    "lucide-react": "^0.536.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^15.4.1",
    "react-router-dom": "^7.8.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.2.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.1.1",
    "vitest": "^5.0.3"
  }
}
