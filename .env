# ATLAS Learn Environment Configuration
# Committed and therefore read by EVERY build, including the real production build of
# learn.neuralworks.lk. Never put a backend host/port here: the browser API base stays unset
# (same-origin /api, proxied by nginx in production and by Vite in development).
# Local backend for `npm run dev` -> ATLAS_DEV_API_PROXY_TARGET (default http://localhost:8080).
VITE_USE_MOCK_API=true
VITE_APP_TITLE=ATLAS Learn
